# ---- runtime ----
REFLEXO_ENV=dev
REFLEXO_PUBLIC_BASE_URL=http://localhost:8080
REFLEXO_LOG_LEVEL=INFO

# ---- datastores (local docker compose defaults) ----
REFLEXO_DATABASE_URL=postgresql+asyncpg://reflexo_app:app_dev@localhost:5442/reflexo
REFLEXO_DATABASE_SERVICE_URL=postgresql+asyncpg://reflexo_service:service_dev@localhost:5442/reflexo
REFLEXO_DATABASE_OWNER_URL=postgresql+asyncpg://reflexo_owner:owner_dev@localhost:5442/reflexo
REFLEXO_REDIS_URL=redis://localhost:6390/0
REFLEXO_TEMPORAL_ADDRESS=localhost:7243
REFLEXO_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# ops console links (leave empty to hide); local docker compose serves these
REFLEXO_TEMPORAL_UI_URL=http://localhost:8098
REFLEXO_JAEGER_UI_URL=http://localhost:16686
# docker compose host ports (defaults avoid clashing with other local stacks)
REFLEXO_PG_PORT=5442
REFLEXO_REDIS_PORT=6390
REFLEXO_TEMPORAL_PORT=7243
REFLEXO_TEMPORAL_UI_PORT=8098
# docker compose role passwords (must match the URLs above)
REFLEXO_DB_OWNER_PASSWORD=owner_dev
REFLEXO_APP_DB_PASSWORD=app_dev
REFLEXO_SERVICE_DB_PASSWORD=service_dev
TEMPORAL_DB_PASSWORD=temporal_dev

# ---- demo ----
REFLEXO_DEMO_TIME_SCALE=1.0          # demo: 0.000694 (1 day ≈ 60 s)
REFLEXO_ADMIN_USER=admin
REFLEXO_ADMIN_SESSION_SECRET=change-me-32-random-chars
REFLEXO_ADMIN_PASSWORD=change-me
# optional read-only reviewer login; it sees only the listed business slugs
REFLEXO_REVIEWER_USER=
REFLEXO_REVIEWER_PASSWORD=
REFLEXO_REVIEWER_BUSINESSES=meeras-bakes

# ---- seed identities (scripts/seed.py) ----
REFLEXO_SEED_OWNER_WA_E164=+91XXXXXXXXXX       # Meera's personal WhatsApp (NOT the business number)
REFLEXO_SEED_OWNER_TG_USER_ID=000000000        # Meera's Telegram numeric user id
REFLEXO_SEED_WA_PHONE_NUMBER_ID=               # business WhatsApp phone_number_id
REFLEXO_SEED_WA_DISPLAY_NUMBER=+91XXXXXXXXXX   # business WhatsApp number (for wa.me links)
REFLEXO_SEED_TG_BOT_ID=                        # numeric bot id (first part of the bot token)
REFLEXO_SEED_FB_PAGE_ID=
REFLEXO_SEED_IG_ACCOUNT_ID=

# ---- gateway ----
REFLEXO_MEDIA_DIR=./data/media
REFLEXO_MEDIA_URL_SECRET=change-me
REFLEXO_SIMULATOR_SECRET=change-me

# ---- Meta ----
REFLEXO_META_APP_ID=
REFLEXO_META_APP_SECRET=
REFLEXO_META_VERIFY_TOKEN=
REFLEXO_META_GRAPH_VERSION=v23.0
REFLEXO_WA_ACCESS_TOKEN=                 # permanent system-user token
REFLEXO_WA_DISPLAY_NUMBER=+91XXXXXXXXXX  # business WhatsApp number (wa.me links)
REFLEXO_FB_PAGE_TOKEN=
REFLEXO_IG_ACCESS_TOKEN=
REFLEXO_IG_APP_SECRET=                   # only if Instagram webhooks are signed with the Instagram app secret

# ---- credential vault and archive (beta WP-02, BETA_10 §4) ----
# "<key_id>:<base64 32 bytes>[,<key_id>:<key>]"; generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
REFLEXO_VAULT_KEYS=
REFLEXO_VAULT_ACTIVE_KEY_ID=
REFLEXO_ARCHIVE_KEYS=                    # a separate key ring, never a vault key (used from WP-06)
REFLEXO_ARCHIVE_ACTIVE_KEY_ID=

# ---- platform connections (beta WP-02, BETA_03 §3): the Reflexo number; the Reflexo bot is the Telegram token ----
REFLEXO_HOUSE_WA_PHONE_NUMBER_ID=
REFLEXO_HOUSE_WA_ACCESS_TOKEN=

# ---- Telegram ----
REFLEXO_TELEGRAM_BOT_TOKEN=
REFLEXO_TELEGRAM_WEBHOOK_SECRET=

# ---- models (WP-05) ----
REFLEXO_MODEL_PROVIDER=gemini            # or "fake" for offline development
REFLEXO_GOOGLE_API_KEY=                  # Gemini API key (paid tier for the demo)
REFLEXO_MODEL_PRIMARY=gemini-2.5-flash
REFLEXO_MODEL_FALLBACK=gemini-2.5-flash-lite
REFLEXO_EMBEDDING_MODEL=gemini-embedding-001
REFLEXO_MODEL_MESSAGES=gemini-2.5-flash        # the messages role: the cheapest model that passes the messages eval

# ---- policy engine and messages (beta WP-26, BETA_04 §7, BETA_13 §6) ----
REFLEXO_POLICY_ENGINE=cedar                     # or "reference" (the POC evaluator), only chosen explicitly
REFLEXO_POLICY_DIR=config/policy
REFLEXO_POLICY_CHECK_CMD=reflexo-policy-check   # workstation: docker run --rm -i reflexo-policy-check:0.1.0
REFLEXO_POLICY_CHECK_TIMEOUT_S=10
REFLEXO_MESSAGES_DIR=config/messages            # purposes.yaml and fallbacks/<language>.yaml
REFLEXO_MESSAGE_REPAIR_ROUNDS=1
REFLEXO_FALLBACK_HOLDING_PER_DAY=1              # holding lines per customer conversation per day

# ---- privacy (beta WP-22a, BETA_10 §16) ----
REFLEXO_RIGHTS_RESPONSE_DAYS=30                 # published response period for data requests
REFLEXO_PRIVACY_EMAIL=privacy@holoncode.in      # grievance officer, shown in the notices
REFLEXO_LEGAL_DIR=legal                         # the legal drafts rendered as public pages
REFLEXO_OPERATOR_TOTP_REQUIRED=true             # operator console login needs a TOTP code
REFLEXO_OPERATOR_TOTP_SECRET=                   # base32 secret for the operator's authenticator app
REFLEXO_CUSTOMER_NOTICE_ENABLED=true            # privacy notice in each new customer's first reply (off only in dev)

# ---- speed and cost (beta WP-01, BETA_12 §11) ----
REFLEXO_MODEL_PRICES=config/model_prices.yaml   # the price file; edited only in a reviewed change
REFLEXO_FX_PRIMARY_URL=https://api.frankfurter.dev/v1/latest?base=USD&symbols=INR
REFLEXO_FX_FALLBACK_URL=https://open.er-api.com/v6/latest/USD
REFLEXO_FX_REFRESH_AT=06:00                     # IST, daily
REFLEXO_FX_ALERT_AFTER_DAYS=3                   # carried-forward days in a row before the operator is alerted
REFLEXO_COST_CAP_DAILY_INR=30                   # default daily AI cost cap per business
REFLEXO_COST_CAP_DEGRADE_PCT=100                # used from WP-11
REFLEXO_COST_CAP_PAUSE_PCT=150                  # used from WP-11
REFLEXO_TURN_MAX_DB_QUERIES=60                  # warning threshold in X-ray
REFLEXO_BENCHMARK_RUNS_RELEASE=3
REFLEXO_BENCHMARK_REGRESSION_PCT=10

# ---- voice (WP-12a) ----
REFLEXO_LIVEKIT_URL=wss://<project>.livekit.cloud
REFLEXO_LIVEKIT_API_KEY=
REFLEXO_LIVEKIT_API_SECRET=
REFLEXO_DEEPGRAM_API_KEY=
REFLEXO_STT_MODEL=nova-3
REFLEXO_TTS_MODEL=aura-2-asteria-en
REFLEXO_VOICE_MODEL=gemini-2.5-flash-lite
# REFLEXO_VOICE_BRIDGE_ID=<stable id per bridge instance; defaults to <hostname>:voice-bridge>

# ---- later work packages ----
# Razorpay (WP-09), Shopify (F15)
