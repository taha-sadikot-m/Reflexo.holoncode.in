# HTTPS for the whole app (certificates are issued and renewed automatically).
# REFLEXO_DOMAIN: the public host name (a real domain, or <ip-with-dashes>.sslip.io until one exists).
# REFLEXO_REDIRECT_FROM: earlier addresses that should keep working, sent to the same path on REFLEXO_DOMAIN.
{$REFLEXO_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

{$REFLEXO_REDIRECT_FROM} {
	redir https://{$REFLEXO_DOMAIN}{uri} permanent
}

# REFLEXO_LEGAL_DOMAIN: a host for the public legal pages alone, as static files (scripts/render_legal.py writes
# them into deploy/legal-site on the server), so they stay up whatever runs on the main host.
{$REFLEXO_LEGAL_DOMAIN} {
	encode zstd gzip
	root * /srv/legal
	try_files {path} {path}.html
	file_server
}
